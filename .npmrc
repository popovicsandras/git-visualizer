# npm supply-chain hardening (targets npm 12, see package.json "engines").
# This project has zero dependencies today; these settings are here so the
# first dependency someone adds is already installed under a strict policy.
# Reference: https://docs.npmjs.com/cli/v12/using-npm/config

# Refuse package versions published less than 3 days ago. Most malicious
# releases (hijacked maintainer accounts, worm-published versions) are caught
# and unpublished within hours, so a short delay avoids installing them.
# Older npm silently ignores this key; there the equivalent is:
#   npm install --before="$(date -v-3d +%Y-%m-%d)"
min-release-age=3

# npm 12 already skips dependency install scripts (preinstall/install/
# postinstall) unless approved with `npm approve-scripts`, but only warns.
# This turns an unapproved script into a hard install failure, so it can't
# slip by unnoticed in a long install log.
strict-allow-scripts=true

# Block dependencies fetched from git repositories or arbitrary URLs (tarballs).
# Both bypass the registry, so they skip min-release-age, provenance and
# malware scanning, and a git dependency's own .npmrc can point npm at a
# different git binary. These are already npm 12 defaults; set explicitly so
# a user/global .npmrc can't quietly loosen them for this project.
allow-git=none
allow-remote=none

# Local tarball and directory dependencies are allowed by default ("all").
# "root" only allows the ones declared in this project's own package.json,
# so a transitive dependency can't pull in arbitrary files from disk.
allow-file=root
allow-directory=root

# Never load a project-root .npm-extension.mjs/.cjs. npm 12 executes that file
# on install; we don't use one, so a planted one (e.g. via a PR) must not run.
ignore-extension=true

# Enforce "engines" instead of only warning: refuse to install a dependency
# that doesn't support our Node version.
engine-strict=true

# Save exact versions ("1.2.3" instead of "^1.2.3"), so a new upstream release
# never enters the tree without a deliberate change to package.json.
save-exact=true

# Make `npm audit` fail on moderate-or-worse vulnerabilities (useful in CI).
audit-level=moderate

# Deliberately NOT set here:
# - allow-scripts: only valid for npx/global installs; project-scoped use errors.
#   Approve a dependency's install script with `npm approve-scripts <pkg>`.
# - ignore-scripts: redundant with the npm 12 script policy above.
# - provenance / bypass-2fa: publishing only; package.json has "private": true,
#   which already makes npm refuse to publish this package at all.

# Supply-chain guard: refuse package versions published less than 3 days ago.
# Needs npm >= 11.10 (this project expects npm 12, see package.json "engines").
# Older npm silently ignores this key; there the equivalent is:
#   npm install --before="$(date -v-3d +%Y-%m-%d)"
# npm 12 also blocks dependency install scripts and git/URL dependencies by default.
# (This project currently has zero dependencies, so nothing is installed.)
min-release-age=3
